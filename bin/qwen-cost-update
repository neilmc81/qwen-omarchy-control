#!/usr/bin/env python3
"""qwen-cost-update: aggregate Qwen voice cost/usage into display records.

Two data sources:
  * Token usage: ~/.config/qwaudio/state/usage.jsonl, one line per completed
    realtime response. Stock qwen-audio-agent does not write this file; it is
    captured only when the gateway journals response.done usage itself. The
    figures are reported as historical when capture is not running, and Alibaba
    Cloud billing remains the authoritative live cost.
  * LIVE billing (optional): Alibaba Cloud BSS via an AccessKey stored in
    ~/.config/qwaudio/cost.json. Queries account balance + this month's bill
    (QueryAccountBalance / QueryBillOverview). Without credentials it falls
    back to a local estimate using the configured per-1K-token rates.

Writes display records to $XDG_STATE_HOME/qwen-voice/cost/ (overview.json,
daily.json, meta.json) for the qwen.cost bar widget to watch.

Run with --refresh to force the live billing fetch; otherwise it reuses a
recent billing snapshot so the panel stays snappy.
"""

from __future__ import annotations

import argparse
import base64
import datetime as dt
import hashlib
import hmac
import json
import os
import shutil
import sys
import tempfile
import time
import uuid
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

# ---------------------------------------------------------------------------
# Paths and config
# ---------------------------------------------------------------------------

HOME = Path.home()
CONFIG_DIR = Path(os.environ.get("QWEN_AUDIO_CONFIG_DIR", HOME / ".config" / "qwaudio"))
USAGE_FILE = Path(os.environ.get("QWEN_AUDIO_USAGE_FILE", CONFIG_DIR / "state" / "usage.jsonl"))
COST_CONFIG = Path(os.environ.get("QWEN_AUDIO_COST_CONFIG", CONFIG_DIR / "cost.json"))
# QWEN_VOICE_COST_STATE_DIR overrides the output directory so tests and dry runs
# never write to (or delete from) the live widget state under XDG_STATE_HOME.
STATE_DIR = Path(os.environ.get("QWEN_VOICE_COST_STATE_DIR")
                 or Path(os.environ.get("XDG_STATE_HOME", HOME / ".local" / "state"))
                 / "qwen-voice" / "cost")

# DashScope realtime is billed on reported tokens. Without a real price the
# local estimate is 0 until the user fills in rates in cost.json (USD per 1K).
DEFAULT_RATES = {
    "qwen-audio-3.0-realtime-flash": {"inputPer1k": 0.0, "outputPer1k": 0.0},
}

BSS_ENDPOINT = "https://business.ap-southeast-1.aliyuncs.com/"
BSS_VERSION = "2017-12-14"
BILLING_SNAPSHOT_TTL_SEC = 30 * 60  # reuse a live billing result for 30 min


def write_json_atomic(path: Path, data: dict) -> None:
    """Publish complete private records; FileView must never see partial JSON."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as stream:
            json.dump(data, stream, ensure_ascii=False, indent=1)
            stream.write("\n")
        os.replace(name, path)
    finally:
        Path(name).unlink(missing_ok=True)


def load_config() -> dict:
    cfg = {"accessKeyId": "", "accessKeySecret": "", "freeQuota": None,
           "rates": DEFAULT_RATES}
    if COST_CONFIG.exists():
        try:
            data = json.loads(COST_CONFIG.read_text())
            for key in ("accessKeyId", "accessKeySecret", "freeQuota", "rates"):
                if data.get(key) is not None:
                    cfg[key] = data[key]
        except (OSError, ValueError):
            pass
    return cfg


# ---------------------------------------------------------------------------
# Alibaba Cloud BSS (OpenAPI v1, HMAC-SHA1 signature)
# ---------------------------------------------------------------------------


def bss_sign(params: dict, secret: str) -> str:
    def enc(value: str) -> str:
        return urllib.parse.quote(str(value), safe="~")

    canonical = "&".join(
        f"{enc(k)}={enc(v)}" for k, v in sorted(params.items()))
    string_to_sign = f"GET&%2F&{urllib.parse.quote(canonical, safe='~')}"
    digest = hmac.new(
        (secret + "&").encode("utf-8"), string_to_sign.encode("utf-8"),
        hashlib.sha1,
    ).digest()
    return base64.b64encode(digest).decode("utf-8")


def bss_call(cfg: dict, action: str, extra: dict | None = None) -> dict:
    access_key = (cfg.get("accessKeyId") or "").strip()
    secret = (cfg.get("accessKeySecret") or "").strip()
    if not access_key or not secret:
        raise RuntimeError("no Alibaba Cloud AccessKey configured in cost.json")
    params = {
        "AccessKeyId": access_key,
        "Action": action,
        "Format": "JSON",
        "SignatureMethod": "HMAC-SHA1",
        "SignatureNonce": str(uuid.uuid4()),
        "SignatureVersion": "1.0",
        "Timestamp": dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "Version": BSS_VERSION,
    }
    params.update(extra or {})
    params["Signature"] = bss_sign(params, secret)
    query = urllib.parse.urlencode(params)
    req = urllib.request.Request(f"{BSS_ENDPOINT}?{query}", method="GET")
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            data = json.loads(resp.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        # Never publish the signed request URL or an AccessKey in widget errors.
        try:
            code = json.loads(exc.read().decode("utf-8")).get("Code", exc.code)
        except (ValueError, UnicodeError):
            code = exc.code
        raise RuntimeError(f"Alibaba billing API {action}: {code}") from None
    if data.get("Success") is False or data.get("Code") not in (None, "Success", "200"):
        raise RuntimeError(f"Alibaba billing API {action}: {data.get('Code', 'failed')}")
    return data


def connect_billing_key(key_file: Path) -> dict:
    """Install a RAM reader key privately, only after its billing calls succeed."""
    try:
        data = json.loads(key_file.read_text())
        key = data.get("AccessKey", data)
        access_key = key["AccessKeyId"]
        secret = key["AccessKeySecret"]
        if not isinstance(access_key, str) or not isinstance(secret, str) or not access_key or not secret:
            raise ValueError("empty credential")
    except (OSError, ValueError, KeyError, TypeError):
        raise RuntimeError("The AccessKey file is missing or invalid.") from None
    cfg = load_config()
    cfg.update(accessKeyId=access_key, accessKeySecret=secret)
    billing = fetch_live_billing(cfg)
    write_json_atomic(COST_CONFIG, cfg)
    write_json_atomic(billing_snapshot_path(), billing)
    return cfg


def fetch_live_billing(cfg: dict) -> dict:
    """Return a billing record from Aliyun BSS, or raise."""
    result: dict = {"source": "aliyun", "fetchedAt": dt.datetime.now().isoformat(timespec="seconds")}
    balance = bss_call(cfg, "QueryAccountBalance").get("Data") or {}
    result["balance"] = balance.get("AvailableAmount")
    result["cashAmount"] = balance.get("CashAmount")
    result["currency"] = balance.get("Currency")
    this_month = dt.date.today().strftime("%Y-%m")
    bill = bss_call(cfg, "QueryBillOverview", {"BillingCycle": this_month})
    items = (((bill.get("Data") or {}).get("Items") or {}).get("Item")) or []
    if isinstance(items, dict):
        items = [items]
    result["month"] = this_month
    result["monthItems"] = [
        {"product": it.get("ProductName") or it.get("ProductCode"),
         "productCode": it.get("ProductCode"),
         "productType": it.get("ProductType"),
         "pretaxGrossAmount": it.get("PretaxGrossAmount"),
         "pretaxAmount": it.get("PretaxAmount")}
        for it in items
    ]
    try:
        result["monthBill"] = round(
            sum(float(it.get("PretaxAmount") or 0) for it in items), 4)
    except (TypeError, ValueError):
        result["monthBill"] = None
    studio_items = [it for it in items if it.get("ProductCode") == "sfm"]
    voice_items = [it for it in studio_items
                   if it.get("ProductType") == "sfm_inferenceFunAudio_public_intl"]
    result["modelStudioMonthBill"] = round(sum(float(it.get("PretaxAmount") or 0)
                                              for it in studio_items), 4)
    result["modelStudioPayable"] = round(sum(float(it.get("AfterTaxAmount")
                                                  if it.get("AfterTaxAmount") is not None
                                                  else it.get("PretaxAmount") or 0)
                                            for it in studio_items), 4)
    result["modelStudioRoundDownDiscount"] = round(sum(float(it.get("RoundDownDiscount") or 0)
                                                      for it in studio_items), 6)
    # Model Studio's cost overview displays usage before invoice rounding.
    # Keep it distinct from PretaxAmount, the actual rounded bill amount.
    result["modelStudioGrossCost"] = round(sum(float(it.get("PretaxGrossAmount")
                                                    if it.get("PretaxGrossAmount") is not None
                                                    else it.get("PretaxAmount") or 0)
                                              for it in studio_items), 6)
    result["voiceMonthBill"] = round(sum(float(it.get("PretaxAmount") or 0)
                                       for it in voice_items), 4) if voice_items else None
    return result


def billing_snapshot_path() -> Path:
    return STATE_DIR / "billing.json"


def read_live_billing(cfg: dict, force: bool) -> dict:
    snap = billing_snapshot_path()
    cached = None
    if snap.exists():
        try:
            data = json.loads(snap.read_text())
            if data.get("source") == "aliyun":
                cached = data
            fetched = data.get("fetchedAt", "")
            if not force and fetched and data.get("month") == dt.date.today().strftime("%Y-%m"):
                age = time.time() - dt.datetime.fromisoformat(fetched).timestamp()
                if 0 <= age < BILLING_SNAPSHOT_TTL_SEC:
                    return data
        except (ValueError, OSError):
            pass
    try:
        data = fetch_live_billing(cfg)
        write_json_atomic(snap, data)
        return data
    except Exception as exc:  # noqa: BLE001 - report to the widget, keep going
        if cached:
            return {**cached, "stale": True, "error": str(exc)[:300]}
        return {"source": "local-estimate", "error": str(exc)[:300]}


# ---------------------------------------------------------------------------
# Usage aggregation
# ---------------------------------------------------------------------------

TOKEN_FIELDS = ("input_tokens", "output_tokens", "total_tokens")


def load_usage_rows() -> list[dict]:
    if not USAGE_FILE.exists():
        return []
    rows = []
    for line in USAGE_FILE.read_text(errors="replace").splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            row = json.loads(line)
        except ValueError:
            continue
        if not isinstance(row, dict):
            continue
        at = row.get("at", "")
        try:
            row["_local"] = dt.datetime.fromisoformat(at).astimezone()
        except (TypeError, ValueError):
            row["_local"] = None
        rows.append(row)
    return rows


def aggregate(rows: list[dict]) -> dict:
    def zero() -> dict:
        return {"responses": 0, "inputTokens": 0, "outputTokens": 0,
                "totalTokens": 0, "estCostUsd": 0.0}

    def add(bucket: dict, row: dict, rates: dict) -> None:
        model = str(row.get("model") or "unknown")
        rate = rates.get(model) or {}
        inp = int(row.get("input_tokens") or 0)
        out = int(row.get("output_tokens") or 0)
        bucket["responses"] += 1
        bucket["inputTokens"] += inp
        bucket["outputTokens"] += out
        bucket["totalTokens"] += inp + out
        bucket["estCostUsd"] += inp / 1000.0 * float(rate.get("inputPer1k") or 0)
        bucket["estCostUsd"] += out / 1000.0 * float(rate.get("outputPer1k") or 0)

    cfg = load_config()
    rates = cfg.get("rates") or DEFAULT_RATES
    today = dt.date.today()
    month_prefix = today.strftime("%Y-%m")
    out = {
        "today": zero(), "month": zero(), "all": zero(),
        "perModel": {}, "daily": {},
    }
    for row in rows:
        local = row.get("_local")
        if local is None:
            at = row.get("at", "")
            try:
                local = dt.datetime.fromisoformat(at).astimezone()
            except (TypeError, ValueError):
                continue
        add(out["all"], row, rates)
        if local.date() == today:
            add(out["today"], row, rates)
        if local.strftime("%Y-%m") == month_prefix:
            add(out["month"], row, rates)
        day = local.strftime("%Y-%m-%d")
        out["daily"].setdefault(day, zero())
        add(out["daily"][day], row, rates)
        model = str(row.get("model") or "unknown")
        out["perModel"].setdefault(model, {"today": zero(), "month": zero()})
        if local.date() == today:
            add(out["perModel"][model]["today"], row, rates)
        if local.strftime("%Y-%m") == month_prefix:
            add(out["perModel"][model]["month"], row, rates)

    for bucket in list(out["daily"].values()) + \
            [m["today"] for m in out["perModel"].values()] + \
            [m["month"] for m in out["perModel"].values()]:
        bucket["estCostUsd"] = round(bucket["estCostUsd"], 6)
    for key in ("today", "month", "all"):
        out[key]["estCostUsd"] = round(out[key]["estCostUsd"], 6)
    # A zero-rate default is deliberately *not* a $0.00 estimate.  It means
    # no price source has been configured, and presenting it as money has led
    # people to believe the widget was reading their Alibaba bill.
    used_models = {str(row.get("model") or "unknown") for row in rows}

    def has_complete_rate(model: str) -> bool:
        rate = rates.get(model) or {}
        try:
            return float(rate.get("inputPer1k") or 0) > 0 and \
                float(rate.get("outputPer1k") or 0) > 0
        except (TypeError, ValueError):
            return False

    out["estimation"] = {
        "available": bool(used_models) and all(has_complete_rate(model) for model in used_models),
        "currency": "USD",
        "reason": "" if used_models and all(has_complete_rate(model) for model in used_models)
                  else "No complete local price is configured for the recorded model(s).",
    }
    # Token-level usage is no longer captured: the gateway used to be patched to
    # journal response.done.usage, and that patch is gone (it broke on every
    # upgrade). Alibaba's own BSS billing is authoritative; these token figures
    # are whatever the journal held when capture stopped. Report that plainly so
    # nobody reads a frozen number as live.
    out["tokenCapture"] = token_capture_status()
    return out


def _gateway_recorder_present() -> bool | None:
    """True if the installed gateway journals response.done usage itself.

    Stock qwen-audio-agent discards it. An earlier version of this project
    patched the package to record it; that patch is gone because it broke on
    every upgrade. If a future release journals natively (or the user runs an
    opt-in proxy), this returns True and token figures are live. Returns None
    when the package cannot be located, so the caller can fall back to
    reporting the journal's last timestamp without claiming capture is running.
    """
    candidates = []
    explicit = os.environ.get("QWEN_AUDIO_AGENT_ROOT")
    if explicit:
        candidates.append(Path(explicit))
    shim = shutil.which("qwenaudio")
    if shim:
        # <root>/cli/bin/qwenaudio.mjs
        candidates.append(Path(shim).resolve().parents[2])
    for root in candidates:
        provider = root / "server/src/voice/realtime-provider.mjs"
        try:
            return "recordResponseUsage" in provider.read_text()
        except OSError:
            continue
    return None


def _journal_last_timestamp() -> str | None:
    if not USAGE_FILE.exists():
        return None
    try:
        # Read only the tail: the journal can grow without bound.
        with USAGE_FILE.open("rb") as stream:
            stream.seek(0, os.SEEK_END)
            size = stream.tell()
            stream.seek(max(0, size - 8192))
            tail = stream.read().decode("utf-8", errors="replace")
        for line in reversed(tail.splitlines()):
            try:
                at = json.loads(line).get("at")
            except ValueError:
                continue
            if at:
                parsed = dt.datetime.fromisoformat(at)
                if parsed.tzinfo is None:
                    parsed = parsed.replace(tzinfo=dt.timezone.utc)
                return parsed.isoformat(timespec="seconds")
    except (OSError, ValueError):
        return None
    return None


def token_capture_status() -> dict:
    """Whether token-level usage is actually being recorded, and as of when.

    Determined by inspecting the installed gateway, not by guessing from file
    age: a quiet day would otherwise look identical to capture being broken.
    """
    last_at = _journal_last_timestamp()
    present = _gateway_recorder_present()
    if present is True:
        return {"active": True, "lastAt": last_at, "reason": ""}
    reason = ("The gateway does not journal response.done usage, so token "
              "figures are historical. Alibaba Cloud billing is the live "
              "figure.")
    if present is None:
        reason = ("Could not locate the qwen-audio-agent package to check for "
                  "token capture; token figures are historical. Alibaba Cloud "
                  "billing is the live figure.")
    return {"active": False, "lastAt": last_at, "reason": reason}


def quota_record(usage: dict) -> dict | None:
    cfg = load_config()
    quota = cfg.get("freeQuota")
    if not quota or not isinstance(quota, dict):
        return None
    try:
        amount = float(quota.get("amount") or 0)
    except (TypeError, ValueError):
        return None
    if amount <= 0:
        return None
    unit = str(quota.get("unit") or "usd")
    record = {
        "amount": amount,
        "unit": unit,
        "label": str(quota.get("label") or ""),
    }
    if unit == "tokens":
        consumed = usage["all"]["totalTokens"]
        record["consumed"] = consumed
    else:  # usd
        consumed = usage["all"]["estCostUsd"]
        record["consumed"] = round(consumed, 4)
    record["remaining"] = round(amount - consumed, 4)
    record["percent"] = round(min(100.0, consumed / amount * 100.0), 1) if amount else 0.0
    return record


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--refresh", action="store_true",
                        help="force a live Aliyun billing fetch")
    parser.add_argument("--json", action="store_true", help="print overview.json")
    parser.add_argument("--connect-key-file", type=Path,
                        help="privately install a dedicated RAM reader AccessKey JSON file")
    args = parser.parse_args()

    try:
        cfg = connect_billing_key(args.connect_key_file) if args.connect_key_file else load_config()
    except RuntimeError as exc:
        print(str(exc), file=sys.stderr)
        return 1
    usage = aggregate(load_usage_rows())
    billing = read_live_billing(cfg, args.refresh)

    overview = {
        "updatedAt": dt.datetime.now().isoformat(timespec="seconds"),
        "today": usage["today"],
        "month": usage["month"],
        "all": usage["all"],
        "perModel": usage["perModel"],
        "estimation": usage["estimation"],
        "tokenCapture": usage.get("tokenCapture"),
        "quota": quota_record(usage),
        "billing": billing,
    }
    daily = {
        "updatedAt": overview["updatedAt"],
        "days": [
            {"date": day, **usage["daily"][day]}
            for day in sorted(usage["daily"], reverse=True)[:31]
        ],
    }
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    write_json_atomic(STATE_DIR / "overview.json", overview)
    write_json_atomic(STATE_DIR / "daily.json", daily)
    write_json_atomic(STATE_DIR / "meta.json", {
        "usageFile": str(USAGE_FILE),
        "costConfig": str(COST_CONFIG),
        "usageRows": len(load_usage_rows()),
    })

    if args.json:
        print(json.dumps(overview, ensure_ascii=False, indent=1))
    return 0


if __name__ == "__main__":
    sys.exit(main())
